# GET Jobs Bot configuration
# 1. Create a new bot via @BotFather on Telegram -> get the token
# 2. Send /start to your new bot, then get your chat id (e.g. via @userinfobot)
# 3. Set the env vars below

GET_TELEGRAM_BOT_TOKEN=123456:ABC-your-new-bot-token
GET_TELEGRAM_CHAT_ID=your-chat-id

# Optional API keys for extra results
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
